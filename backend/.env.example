# ─────────────────────────────────────────────────────────────
# GovSahayak Backend Environment Variables Template
# Copy these keys into your Render / Koyeb / cloud hosting Dashboard
# ─────────────────────────────────────────────────────────────

# Server Port (Render sets this automatically, but required for local)
PORT=5001

# MongoDB Atlas Database URI (e.g. mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/govsahayak?retryWrites=true&w=majority)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/govsahayak?retryWrites=true&w=majority

# JWT Secret for authenticating users & officers
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Cloudinary Credentials (for document uploads & storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Credentials (for OTP emails and status notifications)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_FROM_EMAIL=your-verified-email@example.com
BREVO_FROM_NAME=GovSahayak Official

# Groq Cloud API Key (for policy RAG Chatbot)
GROQ_API_KEY=gsk_your_groq_api_key
